
if command -v pnpm >/dev/null 2>&1; then
  echo 'pnpm must not be pre-installed' >&2
  exit 1
else
  cd "/app"
  scope="/tmp/werf-packages-UUID"
  /.werf/stapel/embedded/bin/mkdir -p "$scope"
   npm install --prefix "$scope" --no-save --package-lock=false pnpm@9.15.4 || { echo 'pnpm bootstrap failed' >&2; exit 1; }
   "$scope/node_modules/.bin/pnpm" install --frozen-lockfile || { echo 'pnpm dependency installation failed' >&2; exit 1; }
  /.werf/stapel/embedded/bin/rm -rf "$scope" || { echo 'pnpm cleanup failed' >&2; exit 1; }
fi
