
if command -v uv >/dev/null 2>&1; then
  echo 'uv must not be pre-installed' >&2
  exit 1
else
  cd "/app"
  scope="/tmp/werf-packages-UUID"
  /.werf/stapel/embedded/bin/mkdir -p "$scope"
   python3 -m venv "$scope" || { echo 'uv bootstrap failed' >&2; exit 1; }
   "$scope/bin/python" -m pip install --no-cache-dir uv==0.8.17 || { echo 'uv bootstrap failed' >&2; exit 1; }
   "$scope/bin/uv" sync --frozen || { echo 'uv dependency installation failed' >&2; exit 1; }
  /.werf/stapel/embedded/bin/rm -rf "$scope" || { echo 'uv cleanup failed' >&2; exit 1; }
fi
