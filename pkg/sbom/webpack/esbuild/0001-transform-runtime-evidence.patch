diff --git a/pkg/api/api_sbom_test.go b/pkg/api/api_sbom_test.go
new file mode 100644
index 0000000..83392b9
--- /dev/null
+++ b/pkg/api/api_sbom_test.go
@@ -0,0 +1,95 @@
+package api_test
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"testing"
+
+	"github.com/evanw/esbuild/internal/test"
+	"github.com/evanw/esbuild/pkg/api"
+)
+
+func expectedSBOMHash(contents []byte) string {
+	return fmt.Sprintf("sha256:%x", sha256.Sum256(contents))
+}
+
+func TestTransformSBOMRuntimeSelected(t *testing.T) {
+	check := func(name string, input string, options api.TransformOptions, expected bool) {
+		t.Helper()
+		t.Run(name, func(t *testing.T) {
+			t.Helper()
+			result := api.Transform(input, options)
+			if len(result.Errors) != 0 {
+				t.Fatalf("Unexpected errors: %v", result.Errors)
+			}
+			if result.SBOM == nil {
+				t.Fatalf("Expected a non-nil SBOM")
+			}
+			if result.SBOM.RuntimeSelected != expected {
+				t.Fatalf("Expected RuntimeSelected to be %v, got %v for output %q",
+					expected, result.SBOM.RuntimeSelected, string(result.Code))
+			}
+		})
+	}
+
+	check("plain JS has no runtime", "let n = 1", api.TransformOptions{
+		Target: api.ES2015,
+	}, false)
+
+	check("lowered class field needs runtime", "class Foo { bar = 1 }", api.TransformOptions{
+		Target: api.ES2015,
+	}, true)
+
+	check("runtime selection belongs to code beside map and legal outputs", "//! retained license\nclass Foo { bar = 1 }", api.TransformOptions{
+		Target:        api.ES2015,
+		Sourcefile:    "input.js",
+		Sourcemap:     api.SourceMapExternal,
+		LegalComments: api.LegalCommentsExternal,
+	}, true)
+
+	check("lowered async needs runtime", "async function foo() { await bar() }", api.TransformOptions{
+		Target: api.ES2015,
+	}, true)
+
+	check("ESM to CommonJS needs runtime", "export const foo = 1", api.TransformOptions{
+		Format: api.FormatCommonJS,
+	}, true)
+
+	check("CSS never selects the JS runtime", "a { color: red }", api.TransformOptions{
+		Loader: api.LoaderCSS,
+	}, false)
+}
+
+func TestTransformSBOMMetadata(t *testing.T) {
+	input := "class Foo { bar = 1 }"
+	result := api.Transform(input, api.TransformOptions{Target: api.ES2015})
+	if len(result.Errors) != 0 {
+		t.Fatalf("Unexpected errors: %v", result.Errors)
+	}
+	if result.SBOM == nil {
+		t.Fatalf("Expected a non-nil SBOM")
+	}
+	test.AssertEqual(t, result.SBOM.Version, 1)
+	test.AssertEqual(t, result.SBOM.Producer, "dk-sbom/1 esbuild 0.25.0")
+	test.AssertEqualWithDiff(t, result.SBOM.InputSHA256, expectedSBOMHash([]byte(input)))
+	test.AssertEqualWithDiff(t, result.SBOM.OutputSHA256, expectedSBOMHash(result.Code))
+
+	// The hashes must be bound to the actual bytes, not to a constant
+	other := api.Transform("let n = 2", api.TransformOptions{})
+	if other.SBOM.InputSHA256 == result.SBOM.InputSHA256 {
+		t.Fatalf("Expected different inputs to hash differently")
+	}
+	if other.SBOM.OutputSHA256 == result.SBOM.OutputSHA256 {
+		t.Fatalf("Expected different outputs to hash differently")
+	}
+}
+
+func TestTransformSBOMAbsentOnError(t *testing.T) {
+	result := api.Transform("let x = ;", api.TransformOptions{})
+	if len(result.Errors) == 0 {
+		t.Fatalf("Expected a syntax error")
+	}
+	if result.SBOM != nil {
+		t.Fatalf("Expected no SBOM for a failed transform, got %+v", *result.SBOM)
+	}
+}
diff --git a/scripts/sbom-tests.js b/scripts/sbom-tests.js
new file mode 100644
index 0000000..1692321
--- /dev/null
+++ b/scripts/sbom-tests.js
@@ -0,0 +1,118 @@
+// Tests for the additive "sbom" member on transform results. Run with:
+//
+//   node scripts/sbom-tests.js
+//
+// This builds nothing: it uses "npm/esbuild/lib/main.js" plus the "esbuild"
+// binary in the repo root, both of which must already be up to date.
+
+const assert = require('assert')
+const crypto = require('crypto')
+const fs = require('fs')
+const path = require('path')
+
+const repoDir = path.dirname(__dirname)
+process.env.ESBUILD_BINARY_PATH = path.join(repoDir, process.platform === 'win32' ? 'esbuild.exe' : 'esbuild')
+const esbuild = require(path.join(repoDir, 'npm', 'esbuild', 'lib', 'main.js'))
+
+const sha256 = text => 'sha256:' + crypto.createHash('sha256').update(text, 'utf8').digest('hex')
+
+const assertSBOM = (result, input, expectedRuntimeSelected) => {
+  assert.notStrictEqual(result.sbom, undefined)
+  assert.strictEqual(result.sbom.version, 1)
+  assert.strictEqual(result.sbom.producer, 'dk-sbom/1 esbuild ' + fs.readFileSync(path.join(repoDir, 'version.txt'), 'utf8').trim())
+  assert.strictEqual(result.sbom.inputSHA256, sha256(input))
+  assert.strictEqual(result.sbom.outputSHA256, sha256(result.code))
+  assert.strictEqual(result.sbom.runtimeSelected, expectedRuntimeSelected)
+}
+
+const tests = {
+  async transformAsyncNoRuntime() {
+    const input = 'let n = 1'
+    const result = await esbuild.transform(input, { target: 'es2015' })
+    assertSBOM(result, input, false)
+  },
+
+  async transformAsyncWithRuntime() {
+    const input = 'class Foo { bar = 1 }'
+    const result = await esbuild.transform(input, { target: 'es2015' })
+    assertSBOM(result, input, true)
+  },
+
+  async transformSyncWithRuntime() {
+    const input = 'export const foo = 1'
+    const result = esbuild.transformSync(input, { format: 'cjs' })
+    assertSBOM(result, input, true)
+  },
+
+  async transformSyncNoRuntime() {
+    const input = 'let n = 1'
+    const result = esbuild.transformSync(input, { target: 'es2015' })
+    assertSBOM(result, input, false)
+  },
+
+  // Inputs over 1 MiB are passed to the child process through the file system,
+  // and the output comes back the same way. The hashes must still be the hashes
+  // of the real code, not of those temporary file names.
+  async transformLargeInputUsesFileSystem() {
+    const input = '/*' + 'x'.repeat(1024 * 1024) + '*/\nclass Foo { bar = 1 }\n'
+    assert.ok(input.length > 1024 * 1024)
+    const result = await esbuild.transform(input, { target: 'es2015' })
+    assertSBOM(result, input, true)
+  },
+
+  async transformErrorHasNoSBOM() {
+    try {
+      await esbuild.transform('let x = ;', {})
+      throw new Error('Expected a syntax error')
+    } catch (error) {
+      assert.ok(Array.isArray(error.errors) && error.errors.length > 0, 'expected a transform failure')
+      assert.strictEqual(error.sbom, undefined)
+    }
+  },
+
+  async legalCommentsAndMangleCacheStillWork() {
+    const input = '//! legal\nlet x = { foo_: 1 }'
+    const result = await esbuild.transform(input, {
+      legalComments: 'external',
+      mangleProps: /_$/,
+      mangleCache: {},
+    })
+    assert.strictEqual(result.legalComments, '//! legal\n')
+    assert.deepStrictEqual(result.mangleCache, { foo_: 'a' })
+    assertSBOM(result, input, false)
+  },
+
+  async buildResultHasNoSBOM() {
+    const result = await esbuild.build({
+      stdin: { contents: 'class Foo { bar = 1 }' },
+      target: 'es2015',
+      write: false,
+    })
+    assert.strictEqual(result.sbom, undefined)
+    assert.strictEqual(result.outputFiles.length, 1)
+  },
+}
+
+async function main() {
+  let failed = 0
+  for (const name of Object.keys(tests)) {
+    try {
+      await tests[name]()
+      console.log(`✅ ${name}`)
+    } catch (error) {
+      failed++
+      console.error(`❌ ${name}: ${error && error.stack || error}`)
+    }
+  }
+  await esbuild.stop()
+  if (failed > 0) {
+    console.error(`${failed} test(s) failed`)
+    process.exit(1)
+  }
+  console.log(`${Object.keys(tests).length} test(s) passed`)
+}
+
+main().catch(error => {
+  console.error(error)
+  process.exit(1)
+})
