ARG BASE_IMAGE=registry.werf.io/base/alpine:latest

FROM ${BASE_IMAGE}

ARG BASE_DOCKERFILE_IMAGE_NAME
ARG BASE_DOCKERFILE_IMAGE_REPO
ARG BASE_DOCKERFILE_IMAGE_TAG

RUN echo ${BASE_DOCKERFILE_IMAGE_NAME} > /BASE_DOCKERFILE_IMAGE_NAME && \
    echo ${BASE_DOCKERFILE_IMAGE_REPO} > /BASE_DOCKERFILE_IMAGE_REPO && \
    echo ${BASE_DOCKERFILE_IMAGE_TAG} > /BASE_DOCKERFILE_IMAGE_TAG
